# Groq + local embeddings configuration (recommended free/low-cost setup)
GROQ_API_KEY=gsk-your-groq-api-key-here
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=huggingface

# Local embedding model (free, no API key; rebuild vectorstore when changed)
LOCAL_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
LOCAL_EMBEDDING_DEVICE=cpu

# Groq model configuration (Optional)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Optional OpenAI fallback (only if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_GRADE_MODEL=gpt-4o-mini

# RAG Configuration (Optional)
RAG_RERANK_MODEL=llama-3.3-70b-versatile
RAG_ENTITY_RESOLVER_MODEL=llama-3.3-70b-versatile
RAG_AGENT_DISAMBIGUATE_MODEL=llama-3.3-70b-versatile
RAG_QUERY_COMPLETION_MODEL=llama-3.3-70b-versatile
RAG_DECOMPOSITION_MODEL=llama-3.3-70b-versatile

# Feature Flags (Optional)
RAG_USE_CROSS_ENCODER=true
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_ENABLE_QUERY_COMPLETION=true
RAG_ENABLE_QUERY_DECOMPOSITION=true
RAG_ENABLE_MONITORING=true

# ── SOTA Techniques (all enabled by default) ────────────────────────────────
# Contextual Chunking — Anthropic Contextual Retrieval (Sept 2024)
RAG_CONTEXTUAL=true
RAG_CONTEXT_MODEL=llama-3.1-8b-instant

# HyDE — Hypothetical Document Embeddings (Gao et al., SIGIR 2023)
RAG_HYDE=true
RAG_HYDE_MODEL=llama-3.1-8b-instant
RAG_HYDE_N=1

# RAPTOR — Hierarchical Summarisation Tree (Sarthi et al., ICLR 2024)
RAG_RAPTOR=true
RAG_RAPTOR_MODEL=llama-3.1-8b-instant
RAG_RAPTOR_LEVELS=2
RAG_RAPTOR_CLUSTERS=8

# Hybrid fusion: "rrf" (Reciprocal Rank Fusion) or "weighted"
RAG_HYBRID_FUSION=rrf
RAG_RRF_K=60

# MMR diversification
RAG_MMR=true
RAG_MMR_LAMBDA=0.7

# LLM reranking
RAG_RERANK=llm

# Paths (Optional)
RAG_METRICS_LOG_PATH=./data/monitoring/metrics.jsonl
CHROMA_PERSIST_DIR=./data/vectorstore
